{
  "name": "intellistar-1",
  "description": "Intellistar 1 Domestic HTML - Quebec & Canadian Broadcast Edition",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "stream:check": "node scripts/check-stream-pipeline.js",
    "cors": "node ./webroot/js/cors.js",
    "http-server": "http-server ./webroot",
    "dev-server": "live-server ./webroot",
    "start": "node app.js",
    "start-iptv": "node start-iptv.js",
    "start-obs": "node start-obs.js start",
    "launcher": "node launcher.js",
    "launcher:ui": "node launcher-ui.js",
    "ui": "node launcher-ui.js",
    "start-obs-hls": "node start-obs.js start hls",
    "start-obs-youtube": "node start-obs.js start youtube",
    "obs:setup-hls": "node start-obs.js setup-hls",
    "obs:setup-youtube": "node start-obs.js setup-youtube",
    "obs:check": "node start-obs.js check",
    "obs:status": "node start-obs.js status",
    "obs:stop": "node start-obs.js stop",
    "setup-ndi": "bash scripts/setup-ndi.sh",
    "start-ndi": "STREAM_MODE=ndi node start-iptv.js",
    "start-1080p60": "STREAM_PRESET=1080p-60fps node start-iptv.js",
    "generate:icons": "node scripts/generate-2026-icons.js",
    "generate:icons:24": "node scripts/generate-2026-icons.js 24",
    "generate:icons:30": "node scripts/generate-2026-icons.js 30",
    "generate:icons:60": "node scripts/generate-2026-icons.js 60",
    "generate:icons:all": "node scripts/generate-2026-icons.js all",
    "generate:assets": "node scripts/generate-2026-assets.js",
    "generate:all": "node scripts/generate-2026-assets.js && node scripts/generate-2026-icons.js all",
    "deck-start": "./deck-start.sh",
    "deck-kms": "./start-kms.sh",
    "deck-pipewire": "./start-pipewire.sh",
    "forecast": "node forecast.js",
    "forecast:start": "node forecast.js start",
    "forecast:stop": "node forecast.js stop",
    "start-forecast": "node forecast.js start",
    "stop-forecast": "node forecast.js stop",
    "alert": "node alert.js",
    "message": "node message.js",
    "refresh": "node refresh.js",
    "stop": "bash stop.sh || stop.bat",
    "vlc": "bash open-stream-vlc.sh || node vlc.js",
    "stream:vlc": "node vlc.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "date-fns": "^2.23.0",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "http-server": "^14.1.0",
    "ini": "^7.0.0",
    "live-server": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "puppeteer": "^25.8.0",
    "puppeteer-stream": "^3.0.23",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-clean-css": "^4.2.0",
    "gulp-sass": "^5.0.0",
    "gulp-sourcemaps": "^2.6.5"
  }
}
