# IntelliStar Simulator (Quebec / Canadian Edition)
# .gitignore

# Dependencies
node_modules/
jspm_packages/
web_modules/
.npm
.yarn
package-lock.json.bak

# Large Archives and Backups
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.bak
*.backup
.clean_backup/
app_backup*/
Archive.tar.gz
intellistar-quebec-latest.tar
webroot/images-bak.zip

# French Vocal Assets (Omitted from repository due to high file size)
**/vocallocal_fr/**
vocallocal_fr/
webroot/vocallocal_fr/
webroot/vocallocal-fr/
webroot/vocallocal/fr/
webroot/vocallocal/french/
webroot/vocallocal/
*french*.wav
*french*.mp3
*french*.ogg
*french*.flac
*french*.m4a
*fr_vocal*
*vocal_fr*

# Compiled Binaries and Objects
bin/*
!bin/.gitkeep
*.o
*.obj
*.so
*.dylib
*.dll
*.exe

# Stream & Live Video Media Outputs
*.m3u8
*.ts
hls-live/
stream/live/
test_segment.ts

# Logs, PIDs, and Runtime Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
nohup.out
server.log
pids/
*.pid
*.pid.lock
latest

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

